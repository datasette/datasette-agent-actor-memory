{
  "name": "datasette-agent-actor-memory-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"const fs=require('node:fs');fs.rmSync('../datasette_agent_actor_memory/static/gen',{recursive:true,force:true});fs.rmSync('../datasette_agent_actor_memory/manifest.json',{force:true});fs.rmSync('../datasette_agent_actor_memory/static/manifest.json',{force:true})\"",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^25.6.0",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
